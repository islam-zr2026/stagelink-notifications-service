# Copy to .env and fill in real values. Never commit .env.
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# JWT validation: agree on these values with the Identity & Profiles member.
# HS256 = shared secret; RS256 = public key in PEM (newlines written as \n).
JWT_ALGORITHM=HS256
JWT_SIGNING_KEY=change-me-to-the-key-shared-by-identity
JWT_USER_ID_CLAIM=user_id
JWT_ROLE_CLAIM=role

# Shared secret sent by other services in the X-Service-Token header.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_SERVICE_TOKEN=change-me

DB_NAME=notifications_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
